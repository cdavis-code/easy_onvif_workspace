    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onvif",
    "ip-camera",
    "nvr",
    "ptz",
    "rtsp",
    "dart"
  ],
  "author": "cdavis-code",
